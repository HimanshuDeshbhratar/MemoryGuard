# MemoryGuard backend configuration
# Copy to .env and adjust. Everything works with defaults + running FalkorDB.

PORT=4000
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=MEMORYGUARD
# FALKORDB_PASSWORD=

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Demo reset (destructive: drops the MEMORYGUARD graph). Local/demo use only.
ALLOW_DEMO_RESET=true
# Auto-seed the synthetic demo dataset on server start
AUTO_SEED=true

# --- Optional LLM enrichment (narrative only; never authorizes decisions) ---
# none = fully deterministic mode, no key needed (default)
LLM_PROVIDER=none            # none | gemini | groq | openrouter
LLM_API_KEY=
LLM_MODEL=                   # user-supplied; never hard-coded
# Optional OpenAI-compatible base URL override (required for gemini via proxy)
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=20000
